IMESSAGE_ALLOWLIST=*
IMESSAGE_DB_PATH=
IMESSAGE_MAX_PER_MINUTE=8
IMESSAGE_POLL_MS=1500
IMESSAGE_MAX_GLOBAL_PER_MINUTE=20
IMESSAGE_MAX_VOICE_PER_MINUTE=6
IMESSAGE_VOICE=
IMESSAGE_VOICE_REPLIES=
IMESSAGE_VOICE_FORMAT=

# Who may confirm a send over iMessage (comma list of numbers/emails). Unset = any sender may. Audits are always open.
IMESSAGE_CONFIRM_ALLOWLIST=
